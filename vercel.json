        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "pre": "curl/"
          }
        }
      ],
      "dest": "/t/$1.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
